{
  "version": 3,
  "configurePresets": [
    {
      "name": "msvc-release",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/msvc"
    },
    {
      "name": "clangcl-release",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "toolset": "ClangCL",
      "binaryDir": "${sourceDir}/build/clangcl"
    },
    {
      "name": "linux-tests",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/linux",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "msvc-release", "configurePreset": "msvc-release", "configuration": "Release" },
    { "name": "clangcl-release", "configurePreset": "clangcl-release", "configuration": "Release" },
    { "name": "linux-tests", "configurePreset": "linux-tests" }
  ]
}
